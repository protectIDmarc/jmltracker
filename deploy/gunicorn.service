# systemd unit for the JML tracker.
# Install to /etc/systemd/system/jmltracker.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now jmltracker
#
# Gunicorn, never `runserver` — runserver is single-threaded, unhardened and
# explicitly not for production use.

[Unit]
Description=JML Access Request Tracker (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=secops
# Primary group www-data so the socket below is created group-owned by the
# nginx user. Without this the socket has to be world-accessible for nginx to
# reach it, which would let any local account talk to the application.
Group=www-data
WorkingDirectory=/opt/jmltracker/jmltracker

# Config comes from the environment file, not from this unit, so the same unit
# works on any host. Owned by secops, mode 0600 — it holds the database
# password and the secret key.
#
# Note: systemd parses this file itself and its rules are not django-environ's
# — it does not strip quotes the same way and does no variable expansion. Keep
# every value a plain unquoted string.
EnvironmentFile=/opt/jmltracker/jmltracker/.env

ExecStart=/opt/jmltracker/jmltracker/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/jmltracker/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile - \
    jmltracker.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=jmltracker
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jmltracker/jmltracker

[Install]
WantedBy=multi-user.target
