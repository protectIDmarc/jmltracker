# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable the application reads is listed here, with no values.

# --- Core ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required. An unset SECRET_KEY stops the process rather than booting insecure.
SECRET_KEY=

# true only on a developer machine. Never true on a public host.
DEBUG=

# Comma-separated. Required when DEBUG=false.
ALLOWED_HOSTS=

# Comma-separated, scheme included, e.g. https://jml.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# The single lever for database config. PostgreSQL in every environment —
# there is no SQLite fallback, and an unset value fails loudly at startup.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# --- Localisation ---
# Display timezone. Stored timestamps are always UTC. Defaults to UTC.
TIME_ZONE=

# --- Demo deployment ---
# Marks the public portfolio instance (seeded, resettable, shared logins).
DEMO_MODE=

# Shared password applied to requester.demo and approver.demo by the seed
# command. Must match the credentials published in the README. Leave empty
# anywhere that is not the public demo: empty means those two accounts get
# unusable passwords and cannot be logged into.
DEMO_PASSWORD=

# --- TLS / proxy ---
# All default to false. Switch on once the app is behind Nginx with a
# certificate; enabling them without TLS makes the site unreachable.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
USE_X_FORWARDED_PROTO=

# HSTS, in seconds. 0 (default) is off. Switch on only once TLS is confirmed
# working — browsers cache the policy and will refuse plain HTTP for this long
# afterwards, which is not easily undone. 31536000 is one year.
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
